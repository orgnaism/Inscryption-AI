# No API key needed. Weights download to local Hugging Face cache on first run.
FLUX_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
FLUX_DEVICE=auto
FLUX_WIDTH=768
FLUX_HEIGHT=768
FLUX_STEPS=4
FLUX_GUIDANCE=1.0
# Optional local model folder, e.g. FLUX_MODEL_ID=C:/models/FLUX.2-klein-4B
# Optional: HF_HOME=/path/to/your/model/cache
